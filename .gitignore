data/processed/

# ==========================================
# Model Outputs - Keep Selected Results
# ==========================================

# Ignore saved model binaries
outputs/model_results/saved_models/

# Ignore temporary model files
outputs/model_results/*.pkl
outputs/model_results/*.joblib

# Keep evaluation results
!outputs/
!outputs/feature_selection/
!outputs/model_results/

